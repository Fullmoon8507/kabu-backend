# Supabase（またはその他PostgreSQL）の接続URLを設定してください
# 形式: postgresql://ユーザー名:パスワード@ホスト:ポート/データベース名
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# 管理者ユーザー名（デフォルト: admin）
ADMIN_USERNAME=admin

# 管理者パスワード（bcrypt ハッシュ済みの値を設定してください）
# ハッシュ生成コマンド:
#   python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))"
ADMIN_PASSWORD=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT署名に使う秘密鍵（ランダムな文字列を設定してください）
# 生成例: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_secret_key_here

# フロントエンドのオリジン（カンマ区切りで複数指定可）
FRONTEND_ORIGINS=https://your-app.vercel.app,http://localhost:4200
